PORT=8080
HOST=127.0.0.1

# Any OpenAI-compatible chat completions endpoint works here.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: public/self-hosted NetEase Cloud Music API base URL.
# Example shape: https://your-netease-api.example.com
NETEASE_API_BASE=http://127.0.0.1:3003
NETEASE_AUTO_START=false

# Spotify Web API search + Web Playback SDK.
# Full browser playback needs a logged-in Spotify Premium account.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_MARKET=US
MUSIC_SOURCE=spotify

TTS_PROVIDER=auto
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
XIAOMI_TTS_ENDPOINT=https://api.xiaomimimo.com/v1
XIAOMI_TTS_API_KEY=
XIAOMI_TTS_VOICE=mimo_default
XIAOMI_TTS_MODEL=mimo-v2-tts

# Optional: Feishu personal calendar. Use a user access token for calendar reads.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_USER_ACCESS_TOKEN=
FEISHU_CALENDAR_ID=primary

OPENWEATHER_API_KEY=
WEATHER_CITY=
WEATHER_UNITS=metric